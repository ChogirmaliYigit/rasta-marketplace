PORT=4173
HOST=127.0.0.1
SEED_DEMO=false
# First launch of a NEW database only:
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=<a-unique-password-with-at-least-12-characters>
# ADMIN_NAME=Administrator
# Required for a deployed HTTPS server:
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://your-rasta-host.example
# DATABASE_PATH=/persistent/rasta.sqlite
