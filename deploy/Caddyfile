{
    email {$ACME_EMAIL}
    admin off
}

(api_proxy) {
    reverse_proxy api:4173 {
        # Always overwrite caller-supplied forwarding headers.
        header_up X-Forwarded-For {remote_host}
    }
}

(web_headers) {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
}

{$SUPPLIER_DOMAIN} {
    import web_headers
    handle /api/* {
        import api_proxy
    }
    handle {
        root * /srv/wholesaler
        route {
            try_files {path} /index.html
            @html path /index.html
            header @html Cache-Control "no-cache"
            file_server
        }
    }
}

{$ADMIN_DOMAIN} {
    import web_headers
    handle /api/* {
        import api_proxy
    }
    handle {
        root * /srv/admin
        route {
            try_files {path} /index.html
            @html path /index.html
            header @html Cache-Control "no-cache"
            file_server
        }
    }
}

{$API_DOMAIN} {
    import web_headers
    handle /api/* {
        import api_proxy
    }
    handle {
        respond "Not found" 404
    }
}
